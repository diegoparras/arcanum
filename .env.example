# Copiar a .env y ajustar. En producción fijá API key y MASTER KEY.

# Entorno de ARCA: homo (testing) | prod (producción con validez fiscal)
ARCANUM_ENV=homo

# Clave de API que protege el gateway (header X-API-Key en cada request).
# Vacía => se genera al arrancar y se imprime UNA vez en el log.
# Generar:  openssl rand -hex 24
ARCANUM_API_KEY=

# Master key para cifrar las claves privadas de los certificados en la DB.
# OBLIGATORIA en producción. Si la perdés, no se pueden descifrar los certificados.
# Generar:  openssl rand -hex 32
ARCANUM_MASTER_KEY=

# Postgres (usado por docker-compose). Si desplegás a mano, en su lugar podés
# definir DATABASE_URL directamente (postgres://user:pass@host:5432/db).
POSTGRES_USER=arcanum
# Obligatoria con el docker-compose.yml: generala con  openssl rand -hex 16
# (si ya tenías una base creada con la clave por defecto, poné POSTGRES_PASSWORD=arcanum)
POSTGRES_PASSWORD=
POSTGRES_DB=arcanum

# Puerto de escucha (por defecto 8094).
PORT=8094

# Usuario superadmin inicial (default "admin"). Solo aplica con la base vacía.
ARCANUM_ADMIN_USER=
# Contraseña del superadmin inicial (si se omite, se genera y se imprime en el log).
ARCANUM_ADMIN_PASS=

# URL pública de Arcanum (la que ve el navegador, ej. https://arcanum.tu-dominio.com). Hace
# falta para el pase entre apps de la suite Escriba (entrar desde Factorum sin loguearse).
# También se carga desde el menú "Suite Escriba (pase entre apps)" (superadmin).
ARCANUM_PUBLIC_URL=
# Quien llega desde otra app de la suite y no tiene usuario en Arcanum se da de alta solo
# (1, por defecto) o no entra (0). También se cambia desde ese menú.
ARCANUM_SUITE_CREAR_USUARIOS=

# Secreto para firmar las cookies de sesión del panel (64 hex aleatorios: openssl rand -hex 32).
# Si se omite, Arcanum genera uno y lo guarda en el volumen (/data/session-secret, 0600).
# Nunca se usa la clave de API ni la master key para esto.
ARCANUM_SESSION_SECRET=

# Proxies de confianza delante de Arcanum (EasyPanel/Traefik = 1). La IP del cliente para el
# límite de login y la auditoría es la que agrega el último proxy; 0 ignora X-Forwarded-For.
ARCANUM_PROXIES=1

# Token para /metrics (Prometheus). Si se define, el scrape tiene que mandar
# "Authorization: Bearer <token>". Vacío: /metrics queda abierto (solo números agregados).
ARCANUM_METRICS_TOKEN=

# Días que se guarda la auditoría de pedidos (tabla requests). Mínimo 7.
ARCANUM_AUDITORIA_DIAS=90

# Federación opcional con Lockatus (OIDC). Si se dejan vacías, solo login local.
ARCANUM_OIDC_ISSUER=
ARCANUM_OIDC_CLIENT_ID=
ARCANUM_OIDC_CLIENT_SECRET=
# ARCANUM_OIDC_REDIRECT_URI=https://tu-dominio/api/auth/oidc/callback  (opcional; se deriva solo)

# Whitelist opcional de emisores al IMPORTAR comprobantes por QR (CUITs separados por
# coma). Si está vacía, se acepta cualquier emisor (igual se constata contra ARCA).
ARCANUM_EMISORES_PERMITIDOS=

# Emisor GLOBAL de fallback para el PDF. Lo recomendado es cargar los datos fiscales
# POR CUIT desde la UI (Clientes -> Datos fiscales); esto se usa solo si el CUIT no
# tiene datos propios cargados.
# condicionIva: RI | MONOTRIBUTO | EXENTO  (habilita la sugerencia de comprobante A/B/C).
ARCANUM_EMISOR_RAZON_SOCIAL=
ARCANUM_EMISOR_NOMBRE_FANTASIA=
ARCANUM_EMISOR_DOMICILIO=
ARCANUM_EMISOR_CONDICION_IVA=
ARCANUM_EMISOR_IIBB=
ARCANUM_EMISOR_INICIO_ACTIVIDADES=
# Umbral RG 5866 para exigir identificación del consumidor final (default 10.000.000).
ARCANUM_UMBRAL_CF_ID=

# Notificaciones por email (opcional). Si se omite el HOST, solo webhooks.
ARCANUM_SMTP_HOST=
ARCANUM_SMTP_PORT=587
ARCANUM_SMTP_USER=
ARCANUM_SMTP_PASS=
ARCANUM_SMTP_FROM=arcanum@tu-dominio
ARCANUM_NOTIFY_EMAIL=
